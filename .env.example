# ============================================================
# LLM 模型映射网关 —— 环境变量配置
#
# 复制为 .env 即可使用：cp .env.example .env
# 优先级：真实环境变量 > .env 文件 > 内置默认值
#         （docker -e / k8s env 可随时覆盖文件里的值）
# 校验：./bin/gateway -check
#
# 设计原则：能推导的都不配。
#   · 上游协议由请求路径自动识别（/v1/messages → Anthropic，等等）
#   · 认证头与前缀随协议自动切换（Bearer / x-api-key）
#   · 客户端凭据直接透传，网关不持有任何密钥
#   · 连接池由 MAX_CONNS 一个数字推导
#
# 最小可用配置只需一行：UPSTREAM_BASE=https://...
# ============================================================

# ------------------------------------------------------------
# 服务
# ------------------------------------------------------------
ADDR=:8080

# ------------------------------------------------------------
# 仅 docker compose 使用的宿主机映射（网关本身不读这几个）
#
# 默认只绑 127.0.0.1：网关没有准入鉴权，对外暴露前请确认前面有
# 反代或安全组兜底。要监听所有网卡就设 BIND_ADDR=0.0.0.0。
# ------------------------------------------------------------
# BIND_ADDR=127.0.0.1
# PORT=8080                        # 宿主机 -> 网关入口

# ------------------------------------------------------------
# 上游
#
# 地址优先级：X-Upstream-Base 请求头 > UPSTREAM_BASE_<协议> > UPSTREAM_BASE
# ------------------------------------------------------------
UPSTREAM_BASE=https://ark.cn-beijing.volces.com/api/v3

# 是否允许客户端用 X-Upstream-Base 头指定上游地址（默认 true）
#
# 网关自身没有准入鉴权，开启这个头等于把「向任意地址转发」的能力交给客户端，
# 也是把网关当跳板的入口。只有在内网且前置已有可靠鉴权时才应该开启。
UPSTREAM_BASE_FROM_HEADER=false

# 可选：按协议指定不同上游
# UPSTREAM_BASE_ANTHROPIC=https://api.anthropic.com
# UPSTREAM_BASE_RESPONSES=https://api.openai.com
# UPSTREAM_BASE_OPENAI=https://api.openai.com

# 可选：客户端未携带凭据时的兜底 Key。
# 留空则完全透传 —— 网关不持有密钥，Key 合法性由上游判定。
# UPSTREAM_KEY=

# ------------------------------------------------------------
# 超时
#
# 四条超时覆盖四种不同的失败形态，不要用同一个值套：
#
#   UPSTREAM_FIRST_BYTE_TIMEOUT            流式：等响应头，≈ 等首 token（TTFT）
#   UPSTREAM_FIRST_BYTE_TIMEOUT_NONSTREAM  非流式：上游要跑完整段生成才发响应头，
#                                          所以这才是「整段生成」的上限
#   UPSTREAM_TIMEOUT / UPSTREAM_STREAM_TIMEOUT  总时长兜底，按是否流式分开
#   UPSTREAM_STALL_TIMEOUT                 响应头已到、流已建立，但中途不再吐数据
#
# 首字节这两项的量级天然不同：流式按 TTFT 设（几十秒），非流式按生成时长设
# （几分钟）。共用一个值只会二选一地错 —— 按 TTFT 设会误杀长生成，按生成
# 时长设则流式的异常永远检测不出来。
#
# 取值方法：用成功请求的实测分位数，而不是拍脑袋。
#   timeout ≈ 分位数(成功耗时, 0.99) × 1.5~2
# 注意分位数只能基于成功请求统计 —— 把超时请求算进去会让分布被当前阈值
# 截断，下一轮将会算出更小的值，逐次收紧成死循环。
# ------------------------------------------------------------
UPSTREAM_TIMEOUT=600s                        # 非流式总时长（响应头早到时才生效）
UPSTREAM_STREAM_TIMEOUT=30m                  # 流式总时长兜底，防连接泄漏
UPSTREAM_FIRST_BYTE_TIMEOUT=60s              # 流式：等响应头 ≈ TTFT
UPSTREAM_FIRST_BYTE_TIMEOUT_NONSTREAM=300s   # 非流式：等响应头 = 整段生成上限

# 流式空闲超时：两个数据块之间超过它即断开。0 = 关闭（默认）。
#
# 覆盖「流已建立但上游中途不再吐数据」这种形态 —— 首字节与总超时都管不到。
# 没有它，这类请求会一直挂到 UPSTREAM_STREAM_TIMEOUT，期间占着并发名额、
# 连接和请求体内存。取值强依赖上游形态：部分上游长时间推理期间确实一个
# 字节都不发，设小了会误杀正常请求，建议先观察成功流的 chunk 间隔分布。
# UPSTREAM_STALL_TIMEOUT=120s

# ------------------------------------------------------------
# 出网代理
#
# 优先级：X-Upstream-Proxy 请求头 > UPSTREAM_PROXY > HTTP(S)_PROXY 环境变量
#
# 支持 http / https / socks5 / socks5h 四种 scheme，必须传完整 URL
# （裸 host:port 会在启动校验时被拒绝）。socks5 与 socks5h 行为一致，
# 域名均由代理侧解析。
#
# 注意超时语义：UPSTREAM_TIMEOUT 等超时覆盖「网关→代理→上游」整条链路，
# 代理慢会让 FIRST_BYTE_TIMEOUT 比直连时更容易触发。
# ------------------------------------------------------------
# UPSTREAM_PROXY=socks5://127.0.0.1:1080
# UPSTREAM_PROXY=http://user:pass@127.0.0.1:8080

# 是否允许客户端用 X-Upstream-Proxy 头指定代理（默认 false）
# 该头永不转发给上游。开启前请确认调用方可信 —— 它允许客户端
# 指定网关的出网路径，公网暴露时保持关闭。
UPSTREAM_PROXY_FROM_HEADER=false

# 不走代理的主机，语义同标准 NO_PROXY（逗号分隔）
# 默认已包含本机地址，本地 mock 上游联调不会被打进代理
# UPSTREAM_NO_PROXY=localhost,127.0.0.1,::1

# ------------------------------------------------------------
# 模型映射
#
# 匹配顺序（先命中即用）：
#   ① 精确规则   deepseek-pro=deepseek-v3
#   ② 通配规则   claude-*=claude-3-5-sonnet   （按具体度自动排序）
#   ③ 兜底模型   MODEL_MAP_FALLBACK
#
# 运行时先用请求头 X-Model-Map: 对外模型:上游模型;...
# Header 未命中时会继续查下面的静态规则，两者叠加而非互相屏蔽。
#
# 格式：对外模型=上游1|上游2;对外模型2=上游3
# 同一键多个值即等权随机分流（v3|v3|r1 就是 2:1）
# ------------------------------------------------------------
# MODEL_MAP=deepseek-pro=deepseek-v3;deepseek-flash=deepseek-lite

# 通配符支持四种形态，键里带 * 即为通配规则：
#   claude-*        前缀      *-flash       后缀
#   gpt-*-turbo     中缀      *vision*      包含
#   *               全匹配（catch-all，永远最后才匹配）
#
# 多条规则同时命中时选「最具体」的一条，与书写顺序无关：
#   精确 > 字面量更长 > 锚定边界更多
#   例：claude-3-5-haiku 会命中 claude-3-5-* 而非 claude-*
# MODEL_MAP=claude-*=claude-3-5-sonnet;*-flash=gemini-2-flash;*=deepseek-v3

# 兜底模型：精确与通配都未命中时使用。多个值等权随机。
# 适合把长尾的未知模型统一导向一个通用能力模型。
# MODEL_MAP_FALLBACK=deepseek-v3

# true = 首选上游返回 429/500/502/503/504 或连接失败时，
#        自动用兜底模型重试一次（仅在响应正文尚未下发时才会切换，
#        流式一旦开始就绝不重试）。需要先配 MODEL_MAP_FALLBACK。
MODEL_MAP_FAILOVER=false

# true = 未命中任何规则（含兜底）的模型直接 400
# 默认 false：原样透传，新模型零配置可用
MODEL_MAP_STRICT=false

# ------------------------------------------------------------
# 响应脱敏
#
# 只改「字段与短值」，绝不碰模型生成的内容：
#   · model / response.model / message.model  → 整体覆盖为对外模型名
#   · id / system_fingerprint / 错误 code、message、param → 短值替换
#   · content / text / delta 等生成内容字段  → 无论长短一律不动
#   · 超过 SANITIZE_MAX_VALUE_LEN 的字符串   → 视为生成内容，不动
# ------------------------------------------------------------
# SANITIZE_OFF=false

# 别名库：上游模型迭代出版本化名称时登记，确保脱敏完整
# 格式：上游模型=变体1|变体2;上游模型2=变体3
# SANITIZE_ALIASES=deepseek-v3=deepseek-v3-250101|DeepSeek-V3;deepseek-r1=deepseek-r1-250120

# 无条件替换，用于隐藏厂商域名等标识。格式：源=目标;源2=目标2
# SANITIZE_REPLACE=ark.cn-beijing.volces.com=api.internal;volces=internal

# 从响应中删除的头，逗号分隔
SANITIZE_DROP_HEADERS=X-Tt-Logid,X-Client-Request-Id

# 允许做子串替换的字符串长度上限。超过这个长度一律视为模型生成的内容。
SANITIZE_MAX_VALUE_LEN=256

# ------------------------------------------------------------
# 容量与过载保护
#
# 这四个数是一组，不能单独调其中一个：
#
#   MAX_CONNS           单上游主机的连接池规模（空闲连接上限）
#   MAX_INFLIGHT        同时在途请求数上限，超限立即 503 + Retry-After
#   MAX_BODY_BYTES      单请求体内存上限
#   MAX_SANITIZE_BYTES  非流式响应整体读入内存的上限
#
# MAX_INFLIGHT 不是内存护栏 —— 它数的是「条数」，而内存按「字节」消耗：
# 单个最坏请求 = 请求体 + （走 failover 时的）请求体副本 + 响应缓冲。
# 它真正的作用有三个：① 限制 goroutine / 连接 / 文件描述符
# ② 不把超过上游配额的并发压给上游 ③ 过载时快速失败而不是排队。
#
# 取值：min(上游账号并发配额 × 0.8, CPU 压测拐点 × 0.7, 内存 ÷ 平均单请求占用)。
# 注意它与超时是乘数关系：在途数 × 平均时长 = 内存被占用的总时长。
# 长超时配大在途数，等于让上游的一次抖动把网关填满十分钟。
# ------------------------------------------------------------
MAX_CONNS=1024                     # 单上游主机空闲连接上限，其余池参数由它推导

# 同时在途的请求数上限，超出立即返回 503 + Retry-After。
#
# 观察 gateway_requests_rejected_total 持续非零即说明该扩容或调高此值；
# 但调高之前先确认上游真的吃得下，否则只是把 503 换成更晚的 OOM。
MAX_INFLIGHT=1024

# 单请求体上限。chat / embeddings 类请求极少超过几 MB；
# 只有多模态图片 base64 才可能接近这个量级，按实际需要放宽。
MAX_BODY_BYTES=16MB

# 需要脱敏的响应能占用的内存上限。**超出直接返回 400，不做原文直通** ——
# 直通会让上游真实标识（响应里的 model / id、错误正文里的真实模型名）
# 未经处理就落到客户端，而那正是脱敏存在的全部理由。
# 调小省内存但更容易触发 400；调大则遇到大响应时占用更多内存。
# 不需要脱敏的响应（SANITIZE_OFF，或本次请求没有 model 字段）不受此限 ——
# 它们本来就不执行任何替换，此处它只是防大响应打爆内存的护栏。
MAX_SANITIZE_BYTES=16MB

# ------------------------------------------------------------
# 可观测性
#
# 出口只有 Logfire 一个：填了 LOGFIRE_TOKEN 就自动启用，trace 与 metrics
# 都外发，本机不暴露任何指标端口。留空则完全关闭遥测，只剩结构化日志。
# 有 token 但想临时静默上报：显式设 OBS_ENABLED=false，无需删掉 token。
# ------------------------------------------------------------
OBS_SERVICE_NAME=remap-gateway
OBS_ENV=production
# trace 采样比例。指标不受采样影响（计数类由 SDK 独立聚合），
# 所以降采样只损失「单条链路的细节」，代价是每个 span 都要出网的流量。
# 本地排查可以临时设 1.0；线上按 QPS 与成本权衡，一般 0.05 ~ 0.2。
OBS_SAMPLE_RATIO=0.1

LOGFIRE_TOKEN=                     # 填入即开启上报
LOGFIRE_REGION=us                  # us | eu，需与 token 所属区域一致

# 不产生 trace 与指标的路径关键字（逗号分隔，ASCII 大小写无关的子串匹配）。
# 探针与心跳的 QPS 常比真实业务高一个数量级，却无诊断价值：会稀释 P99、
# 抬高上报量、污染 trace 列表。命中的请求仍正常代理，只是不记录可观测数据。
EXCLUDED_URLS=health,healthz,ready,metrics,poll,heartbeat

# 指标上报周期。上报在独立 goroutine，不占请求路径；
# 调大只减少出网次数，代价是看板数据新鲜度。
OBS_METRIC_INTERVAL=60s

# 网关前方可信反向代理的层数，决定客户 IP 从 X-Forwarded-For 的哪一位取值。
# 客户 IP 只作 trace 属性（client.address），不作指标标签 —— IP 基数无上界，
# 进 metric label 会按客户数量线性放大时间序列。
#
#   0  只信任 RemoteAddr，完全忽略 XFF。
#   n  取 XFF 右起第 n 位（RemoteAddr 本身算最右一跳）——
#      前置 1 层 Nginx / CLB 取最右一位；2 层取右起第二位。
#
# 默认 0：网关直接暴露公网时必须用它，否则客户端可自行伪造 XFF 声明任意来源 IP。
#
# ⚠️ 设成非 0 的**前提是网关端口不能被绕过代理直连**：只要客户端能直连网关，
#    它就能自己伪造 XFF 的最右几位，取到的就是假 IP。直连路径必须堵死
#    （端口只绑 127.0.0.1，或安全组只放行代理所在网段）。
#
# 核对本项配置是否正确：发一个带哨兵值的请求，看日志的 client_ip 字段
# （或 span 的 client.address）——
#    显示真实公网 IP  → 正确
#    显示代理/内网 IP → hops 偏小
#    显示哨兵值       → hops 偏大（此时客户端可伪造来源，必须调小）
#   curl -H 'X-Forwarded-For: 203.0.113.99' https://<域名>/v1/models
TRUSTED_PROXY_HOPS=0

# 上游错误响应体上报到 span 的字节上限（0 = 关闭）。
# 各家上游的错误结构互不相同，网关不做字段提取、原样上报，由看板侧判断 ——
# 没有原始正文时，"429" 只能看出被限流，看不出是配额耗尽、并发超限还是
# 模型不存在，排障只能回上游翻日志。
#
# 正文只进 span 属性（gateway.error.body），永不进 metric label：
# 错误文案基数无上界，与 client.address 是同一条约束。
# 截断按 UTF-8 边界回退，不会产出半个汉字的乱码。
# 上游正文可能含租户可识别信息，合规要求严格时置 0 关闭，
# 此时 status 描述也不写入正文。
#
# 同样作用于 failover 的中间失败：切换成功时 span 保持 OK（对客户端确实
# 没故障），但失败现场会以 span 属性留痕 —— 见 gateway.attempt.stage /
# .model / .status_code 与 gateway.attempt.count（计数 > 1 表示前面还有
# 被覆盖掉的失败）。看板里「切换成功」不等于「无事发生」：主模型持续降级
# 只能靠这些属性发现，别只盯最终状态码。
#
# 注：失败现场**不再**用 span event 承载 —— event 在 Logfire 的 trace 列表里
# 占一整行，而它的文案改不掉（logfire.msg 对 event 无效），父 span 已写明
# 上游状态码时纯属噪音。改动见 commit c09ac72。
OBS_ERROR_BODY_BYTES=8192

LOG_LEVEL=info                     # debug | info | warn | error
LOG_FORMAT=json                    # json | text
LOG_UPSTREAM_MODEL=true            # 内部日志记录真实上游模型（审计用）
